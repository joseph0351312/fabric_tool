{
    "name": "test-network-${ORG}",
    "version": "1.0.0",
    "client": {
        "organization": "${ORG}",
        "connection": {
            "timeout": {
                "peer": {
                    "endorser": "300"
                }
            }
        }
    },
    "organizations": {
        "${ORG}": {
            "mspid": "${ORGMSP}MSP",
            "peers": [
                "peer0.${MORG}.com"
            ]
        }
    },
    "peers": {
        "peer0.${MORG}.com": {
            "url": "grpcs://peer0.${MORG}.com:${P0PORT}",
            "tlsCACerts": {
                "pem": "${PEERPEM}"
            },
            "grpcOptions": {
                "ssl-target-name-override": "peer0.${MORG}.com",
                "hostnameOverride": "peer0.${MORG}.com"
            }
        }
    }
}
